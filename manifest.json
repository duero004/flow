{
  "manifest_version": 3,
  "name": "Flow Auto Generator",
  "version": "1.0.0",
  "description": "Otomatisasi generate gambar di Google Flow",
  "permissions": ["storage", "downloads", "activeTab", "scripting"],
  "host_permissions": [
    "https://labs.google/*",
    "https://flow.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Flow Auto Generator"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/fx/tools/flow*",
        "https://flow.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
